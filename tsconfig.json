{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "mobilewright.config.ts",
    "utils/**/*.ts",
    "pages/**/*.ts",
    "fixtures/**/*.ts",
    "tests/**/*.ts",
    "constants/**/*.ts",
    "data/**/*.json"
  ],
  "exclude": ["node_modules", "mobilewright-report", "test-results"]
}
