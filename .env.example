# Copy this file to .env and fill in the values for your machine.

# iOS simulator
IOS_BUNDLE_ID=org.wdiodemoapp
# Treated as a RegExp, e.g. "iPhone 17 Pro" (see `npx mobilewright devices`)
IOS_DEVICE_NAME=iPhone 17 Pro

# Android device
ANDROID_BUNDLE_ID=com.wdiodemoapp
# Serial from `adb devices`
ANDROID_DEVICE_ID=your-adb-device-serial
